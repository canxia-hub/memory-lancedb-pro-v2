{
  "id": "memory-lancedb-pro",
  "name": "Memory LanceDB Pro",
  "version": "3.0.0",
  "kind": "memory",
  "description": "Capability-first LanceDB memory plugin with hybrid retrieval, wiki tools, and host interop (v3)",
  "configSchema": {
    "type": "object",
    "properties": {
      "dbPath": {
        "type": "string",
        "description": "Database storage path (required)"
      },
      "connectionMode": {
        "type": "string",
        "enum": ["embedded", "remote"],
        "default": "embedded",
        "description": "Connection mode: embedded (local) or remote (server)"
      },
      "tableName": {
        "type": "string",
        "default": "memories",
        "description": "Table name in LanceDB"
      },
      "embeddingDimension": {
        "type": "integer",
        "default": 2560,
        "description": "Embedding dimension"
      },
      "readConsistencyIntervalSeconds": {
        "type": "number",
        "default": 5,
        "description": "Seconds between checks for external writes (0=strong consistency, >0=eventual)"
      },
      "defaultScope": {
        "type": "string",
        "default": "default",
        "description": "Default memory scope"
      },
      "retrieval": {
        "type": "object",
        "properties": {
          "hybrid": { "type": "boolean", "default": true },
          "rerank": { "type": "boolean", "default": false },
          "rerankProvider": {
            "type": "string",
            "enum": ["none", "dashscope"],
            "default": "none"
          },
          "rerankModel": { "type": "string", "default": "qwen3-vl-rerank" },
          "rerankBaseUrl": {
            "type": "string",
            "default": "https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank"
          },
          "rerankApiKeyEnv": { "type": "string", "default": "DASHSCOPE_API_KEY" },
          "fts": { "type": "boolean", "default": true, "description": "Enable FTS full-text search index" }
        }
      },
      "hostInterop": {
        "type": "object",
        "properties": {
          "enableArtifacts": { "type": "boolean", "default": true },
          "enableEvents": { "type": "boolean", "default": true }
        }
      },
      "assetsTableName": { "type": "string", "default": "memory_assets" },
      "assetsPath": { "type": "string", "description": "Assets directory path" },
      "vault": {
        "type": "object",
        "properties": { "path": { "type": "string", "description": "Wiki vault path" } }
      },
      "context": {
        "type": "object",
        "properties": { "includeCompiledDigestPrompt": { "type": "boolean", "default": false } }
      },
      "obsidian": {
        "type": "object",
        "properties": { "enabled": { "type": "boolean", "default": false } }
      },
      "embedding": {
        "type": "object",
        "properties": {
          "provider": { "type": "string", "default": "dashscope" },
          "model": { "type": "string", "default": "tongyi-embedding-vision-flash-2026-03-06" },
          "baseUrl": {
            "type": "string",
            "default": "https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding"
          },
          "apiKeyEnv": { "type": "string", "default": "DASHSCOPE_API_KEY" },
          "nativeDimension": { "type": "integer", "default": 768 },
          "storageDimension": { "type": "integer", "default": 2560 }
        }
      },
      "autoCapture": {
        "type": "boolean",
        "default": false,
        "description": "Enable automatic memory capture at agent_end (default: false, 灰度原则)"
      },
      "autoRecall": {
        "type": "boolean",
        "default": false,
        "description": "Enable automatic memory recall at before_prompt_build (default: false, 灰度原则)"
      },
      "captureMaxChars": {
        "type": "integer",
        "default": 500,
        "description": "Maximum character length for auto-captured text (default: 500)"
      },
      "recallMaxChars": {
        "type": "integer",
        "default": 1000,
        "description": "Maximum character length for recall query normalization (default: 1000)"
      },
      "customTriggers": {
        "type": "array",
        "items": { "type": "string" },
        "default": [],
        "description": "Custom trigger phrases for auto-capture (case-insensitive substring match)"
      },
      "reflection": {
        "type": "object",
        "description": "Reflection engine configuration (M3). Default disabled — enable only after testing.",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "Enable reflection distiller at agent_end (default: false, 灰度原则)"
          },
          "distillerModel": {
            "type": ["string", "null"],
            "default": null,
            "description": "Model for distiller sub-session (null=follow agent default model)"
          },
          "maxConcurrency": {
            "type": "integer",
            "default": 2,
            "minimum": 1,
            "description": "Max concurrent distiller runs per agent lane"
          },
          "derivedMaxAgeDays": {
            "type": "integer",
            "default": 14,
            "minimum": 1,
            "description": "Max age in days for derived reflection items (older items pruned from injection)"
          },
          "mappedMaxAgeDays": {
            "type": "integer",
            "default": 60,
            "minimum": 1,
            "description": "Max age in days for mapped reflection items"
          },
          "admissionPreset": {
            "type": "string",
            "enum": ["balanced", "conservative", "high-recall"],
            "default": "balanced",
            "description": "Admission control preset for mapped reflection entries"
          }
        }
      }
    },
    "required": ["dbPath"]
  },
  "activation": {
    "onStartup": true,
    "onCommands": ["wiki"]
  },
  "hooks": {
    "timeoutMs": 60000
  },
  "contracts": {
    "tools": [
      "memory_store",
      "memory_list",
      "memory_recall",
      "memory_update",
      "memory_archive",
      "memory_promote",
      "memory_stats",
      "memory_debug",
      "memory_migrate_legacy",
      "memory_forget",
      "wiki_status",
      "wiki_new",
      "wiki_get",
      "wiki_query",
      "wiki_build",
      "wiki_doctor",
      "wiki_index",
      "wiki_sync_links"
    ]
  },
  "commandAliases": [
    { "name": "wiki" }
  ]
}
