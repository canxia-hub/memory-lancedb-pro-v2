{
  "name": "memory-lancedb-pro",
  "version": "4.1.0",
  "type": "module",
  "description": "Capability-first LanceDB memory plugin for OpenClaw with hybrid retrieval, wiki tools, reflection/dreaming engines, and host interop (v4)",
  "main": "dist/index.js",
  "keywords": [
    "openclaw",
    "memory",
    "lancedb",
    "vector",
    "retrieval",
    "wiki"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/canxia-hub/memory-lancedb-pro-v4.git"
  },
  "engines": {
    "node": ">=18"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "@openclaw/memory-lancedb-pro",
      "localPath": "extensions/memory-lancedb-pro",
      "defaultChoice": "npm"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "dependencies": {
    "@lancedb/lancedb": "^0.33.0",
    "apache-arrow": "18.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.6"
  }
}
